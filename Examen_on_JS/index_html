<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
     rel="stylesheet">
    <link rel="stylesheet" href="style.css">

</head>
<body>
    <div class="wrap">
 
  <header>

    <div class="tagline">Особистий гросбух: кожна гривня записана, кожна витрата пояснена.</div>
  </header>
 
  <section class="stats">
    <div class="stat balance">
      <div class="label">Баланс</div>
      <div class="value" id="statBalance">₴0</div>
    </div>
    <div class="stat income">
      <div class="label">Доходи</div>
      <div class="value" id="statIncome">₴0</div>
    </div>
    <div class="stat expense">
      <div class="label">Витрати</div>
      <div class="value" id="statExpense">₴0</div>
    </div>
  </section>
 
  <div class="spread">
    <div class="left-page">
      <h2 class="section-title">Новий запис</h2>
      <form id="txForm" novalidate>
        <div class="field">
          <label for="txText">Назва</label>
          <input type="text" id="txText" placeholder="Наприклад, купівля продуктів" autocomplete="off">
        </div>
        <div class="field">
          <label for="txAmount">Сума, ₴</label>
          <input type="number" id="txAmount" placeholder="0" min="0" step="0.01">
        </div>
        <div class="field">
          <label>Тип операції</label>
          <div class="type-toggle" id="typeToggle">
            <button type="button" data-type="income" data-active="false">Дохід</button>
            <button type="button" data-type="expense" data-active="true">Витрата</button>
          </div>
        </div>
        <button type="submit" class="submit-btn">Додати запис</button>
        <div class="form-error" id="formError"></div>
      </form>
 
      <div class="convert-block">
        <h2 class="section-title" style="margin-bottom:12px;">Конвертація балансу</h2>
        <button class="convert-btn" id="convertBtn">Конвертувати баланс</button>
        <div class="convert-result" id="convertResult"></div>
      </div>
    </div>
 
    <div class="right-page">
      <h2 class="section-title">Історія операцій</h2>
      <div class="tx-list" id="txList"></div>
    </div>
  </div>
 
</div>


    <script>
        (function(){
  const STORAGE_KEY = "coinguard.transactions";
 
  /** @type {{id:string, text:string, amount:number, type:"income"|"expense", date:string}[]} */
  let transactions = [];
 

  function loadTransactions(){
    try{
      const raw = localStorage.getItem(STORAGE_KEY);
      transactions = raw ? JSON.parse(raw) : [];
    }catch(e){
      transactions = [];
    }
  }
 
  function saveTransactions(){
    localStorage.setItem(STORAGE_KEY, JSON.stringify(transactions));
  }

  const money = new Intl.NumberFormat("uk-UA", {
    style: "currency",
    currency: "UAH",
    maximumFractionDigits: 0
  });
 
  function formatDate(iso){
    const d = new Date(iso);
    return d.toLocaleDateString("uk-UA", { day:"2-digit", month:"2-digit", year:"numeric" });
  }

  function computeStats(){
    return transactions.reduce((acc, t) => {
      if(t.type === "income"){
        acc.income += t.amount;
      }else{
        acc.expense += t.amount;
      }
      acc.balance = acc.income - acc.expense;
      return acc;
    }, { balance: 0, income: 0, expense: 0 });
  }
 
  function renderStats(){
    const { balance, income, expense } = computeStats();
    document.getElementById("statBalance").textContent = money.format(balance);
    document.getElementById("statIncome").textContent = money.format(income);
    document.getElementById("statExpense").textContent = money.format(expense);
  }

  function renderList(){
    const list = document.getElementById("txList");
    list.innerHTML = "";
 
    if(transactions.length === 0){
      const empty = document.createElement("div");
      empty.className = "empty-state";
      empty.textContent = "Поки що жодного запису. Додайте перший дохід або витрату.";
      list.appendChild(empty);
      return;
    }

    const sorted = [...transactions].sort((a, b) => (a.id < b.id ? 1 : -1));
 
    sorted.forEach(t => {
      const row = document.createElement("div");
      row.className = "tx-row";
      row.dataset.type = t.type;
 
      const mark = document.createElement("div");
      mark.className = "tx-mark";
 
      const info = document.createElement("div");
      info.className = "tx-info";
      const textEl = document.createElement("div");
      textEl.className = "tx-text";
      textEl.textContent = t.text;
      const dateEl = document.createElement("div");
      dateEl.className = "tx-date";
      dateEl.textContent = formatDate(t.date);
      info.appendChild(textEl);
      info.appendChild(dateEl);
 
      const amountEl = document.createElement("div");
      amountEl.className = "tx-amount";
      const sign = t.type === "income" ? "+" : "−";
      amountEl.textContent = `${sign} ${money.format(t.amount)}`;
 
      const delBtn = document.createElement("button");
      delBtn.className = "tx-delete";
      delBtn.setAttribute("aria-label", "Видалити запис");
      delBtn.textContent = "✕";
      delBtn.addEventListener("click", () => deleteTransaction(t.id));
 
      row.appendChild(mark);
      row.appendChild(info);
      row.appendChild(amountEl);
      row.appendChild(delBtn);
      list.appendChild(row);
    });
  }
 
  function renderAll(){
    renderStats();
    renderList();
  }

  function addTransaction(text, amount, type){
    const transaction = {
      id: "trx-" + Date.now(),
      text,
      amount,
      type,
      date: new Date().toISOString().slice(0, 10)
    };
    transactions.push(transaction);
    saveTransactions();
    renderAll();
  }
 
  function deleteTransaction(id){
    transactions = transactions.filter(t => t.id !== id);
    saveTransactions();
    renderAll();
  }

  let selectedType = "expense";
 
  function setupTypeToggle(){
    const toggle = document.getElementById("typeToggle");
    toggle.querySelectorAll("button").forEach(btn => {
      btn.addEventListener("click", () => {
        selectedType = btn.dataset.type;
        toggle.querySelectorAll("button").forEach(b => {
          b.dataset.active = (b.dataset.type === selectedType) ? "true" : "false";
        });
      });
    });
  }
 
  function setupForm(){
    const form = document.getElementById("txForm");
    const textInput = document.getElementById("txText");
    const amountInput = document.getElementById("txAmount");
    const errorEl = document.getElementById("formError");
 
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const text = textInput.value.trim();
      const amount = parseFloat(amountInput.value);
 
      if(text === ""){
        errorEl.textContent = "Введіть назву транзакції.";
        return;
      }
      if(isNaN(amount) || amount <= 0){
        errorEl.textContent = "Сума має бути більшою за нуль.";
        return;
      }
 
      errorEl.textContent = "";
      addTransaction(text, amount, selectedType);
 
      form.reset();
      selectedType = "expense";
      document.querySelectorAll("#typeToggle button").forEach(b => {
        b.dataset.active = (b.dataset.type === "expense") ? "true" : "false";
      });
      textInput.focus();
    });
  }

  function setupConvert(){
    const btn = document.getElementById("convertBtn");
    const resultEl = document.getElementById("convertResult");
 
    btn.addEventListener("click", async () => {
      const { balance } = computeStats();
 
      btn.disabled = true;
      resultEl.innerHTML = "Отримання курсу...";
 
      try{
        const response = await fetch("https://api.exchangerate-api.com/v4/latest/UAH");
        if(!response.ok){
          throw new Error("Network response was not ok");
        }
        const data = await response.json();
        const usdRate = data.rates.USD;
        const eurRate = data.rates.EUR;
 
        const usdValue = balance * usdRate;
        const eurValue = balance * eurRate;
 
        resultEl.innerHTML = `
          <div class="rate-line"><span>Баланс у USD</span><span>$${usdValue.toFixed(2)}</span></div>
          <div class="rate-line"><span>Баланс у EUR</span><span>€${eurValue.toFixed(2)}</span></div>
        `;
      }catch(err){
        resultEl.innerHTML = `<span class="convert-error">Помилка завантаження курсу валют</span>`;
      }finally{
        btn.disabled = false;
      }
    });
  }

  function init(){
    loadTransactions();
    setupTypeToggle();
    setupForm();
    setupConvert();
    renderAll();
  }
 
  document.addEventListener("DOMContentLoaded", init);
})();

    </script>
</body>
</html>